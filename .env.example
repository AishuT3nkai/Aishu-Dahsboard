# --- Discord OAuth2 application (Developer Portal) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must exactly match a redirect configured in the Discord Developer Portal,
# e.g. https://your-dashboard.vercel.app/api/auth/callback
DISCORD_REDIRECT_URI=

# --- The exactly-two authorized dashboard admins ---
ADMIN_USER_ID_1=
ADMIN_USER_ID_2=

# Optional: pin the dashboard to a single default guild. If unset, the guild
# switcher shows every guild the bot and the logged-in admin have in common.
ADMIN_GUILD_ID=

# --- Session signing ---
# Long random string. `openssl rand -hex 32`
DASHBOARD_SESSION_SECRET=

# --- Bot bridge ---
# The Aishu-Bot process (on Nexus Host) must run the small HTTP bridge
# described in dashboard/BRIDGE.md, reachable from Vercel, and must not be
# publicly exposed beyond that shared secret.
BOT_API_BASE_URL=
BOT_API_SHARED_SECRET=
