# --- Discord OAuth2 application (Developer Portal) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must exactly match a redirect configured in the Developer Portal,
# e.g. https://your-dashboard.vercel.app/api/auth/callback
DISCORD_REDIRECT_URI=

# --- The exactly-two authorized dashboard admins ---
ADMIN_USER_ID_1=
ADMIN_USER_ID_2=

# Optional: pin the dashboard to a single default guild. If unset, the
# guild switcher shows guilds shared by the signed-in admin and the bot.
ADMIN_GUILD_ID=

# --- Session signing ---
# Generate a long random value with: openssl rand -hex 32
DASHBOARD_SESSION_SECRET=

# --- Bot bridge ---
# The Aishu-Bot process must implement the HTTP API described in BRIDGE.md.
# Use a private HTTPS endpoint reachable from Vercel; never expose the bridge
# without checking this shared secret on every request.
BOT_API_BASE_URL=
BOT_API_SHARED_SECRET=
